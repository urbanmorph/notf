{
  "outputDirectory": "website/public",
  "framework": null,
  "buildCommand": null,
  "rewrites": [
    {
      "source": "/api/supabase/:path*",
      "destination": "https://abblyaukkoxmgzwretvm.supabase.co/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/cities/:city/climate/air-quality(/.*)?",
      "destination": "https://oaq.notf.in",
      "permanent": true
    },
    {
      "source": "/cities/:city/stories(/.*)?",
      "destination": "/stories/",
      "permanent": true
    },
    {
      "source": "/cities/:city/solution-providers(/.*)?",
      "destination": "/solution-providers/",
      "permanent": true
    },
    {
      "source": "/cities/:city(/.*)?",
      "destination": "/communities/?city=:city",
      "permanent": true
    },
    {
      "source": "/cities(/)?",
      "destination": "/communities/",
      "permanent": true
    }
  ]
}
